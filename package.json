{
  "name": "manageinn-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Manage Inn — Ionic Vue mobile companion to the Manage Inn Frappe app",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
