    "cap:open:android": "cap open android",
    "dev:android": "bash scripts/dev-android.sh"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/camera": "^8.2.0",
